---
import { Image } from "astro:assets";
import layoutStyles from "./layout.module.css";
import githubLogo from "../images/github-logo20px.png";
import opencollectiveLogo from "../images/opencollective-logo20px.png";
---

<nav>
  <ul class={layoutStyles["nav-links"]}>
    <li>
      <a href="/" class={layoutStyles["nav-link-text"]}>home</a>
    </li>
    <li>
      <a href="/analysis" class={layoutStyles["nav-link-text"]}
        >📒 analysis</a
      >
    </li>
    <li>
      <a href="/tools" class={layoutStyles["nav-link-text"]}>🔨 tools</a>
    </li>
    <li>
      <a href="/scripting" class={layoutStyles["nav-link-text"]}
        >💾 scripting</a
      >
    </li>
    <li>
      <a href="/community" class={layoutStyles["nav-link-text"]}
        >🤸 community</a
      >
    </li>
    <li class={layoutStyles.navSpacer}>&nbsp;</li>
    <li class="icon">
      <a href="https://github.com/loathers">
        <Image src={githubLogo} alt="github" width={20} height={20} />
      </a>
    </li>
    <li class="icon">
      <a href="https://opencollective.com/loathers">
        <Image
          src={opencollectiveLogo}
          alt="opencollective"
          width={20}
          height={20}
        />
      </a>
    </li>
    <li class="icon">
      <a href="/rss.xml" aria-label="RSS feed" title="RSS feed">
        <!-- Feed icon from Feather Icons (MIT), in the same light gray as the logos -->
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" aria-hidden="true">
          <path d="M4 11a9 9 0 0 1 9 9" />
          <path d="M4 4a16 16 0 0 1 16 16" />
          <circle cx="5" cy="19" r="1.5" fill="currentColor" stroke="none" />
        </svg>
      </a>
    </li>
  </ul>
</nav>

<style>
  img,
  svg {
    display: inline-block;
    line-height: 25px;
    margin: 0px;
    vertical-align: middle;
  }

  /* On narrow screens, let the header nav wrap instead of squeezing the links and icons */
  @media (max-width: 480px) {
    ul {
      flex-wrap: wrap;
      padding-right: 4px;
    }

    li:not(.icon) a {
      white-space: nowrap;
      padding-left: 8px;
      padding-right: 8px;
    }

    img,
    svg {
      flex-shrink: 0;
      margin: 0 4px;
    }
  }

  svg {
    color: rgb(220, 220, 220);
  }
</style>
