---
interface Props {
  itemName?: string;
}

const { itemName = "" } = Astro.props;
const highlights = {
  Spooky: "gray",
  Hot: "red",
  Sleaze: "purple",
  Cold: "blue",
  Stench: "green",
};

let html = await Astro.slots.render("default");

for (const [word, color] of Object.entries(highlights)) {
  const regex = new RegExp(`\\b${word}\\b(?![^<]*>)`, "gi");
  html = html.replace(
    regex,
    `<span style="color:${color};font-weight:bold">${word}</span>`,
  );
}
---

<div class="itemBox">
  <h3>{itemName}</h3>
  <Fragment set:html={html} />
</div>

<style>
  .itemBox {
    background: #ffffff;
    color: blue;
    width: 60%;
    padding: 20px;
    margin: 30px 20%;
    border: thick solid rgb(180, 180, 255);

    box-shadow: 0 0 1rem hsla(0, 0%, 41%, 0.35);
  }

  .itemBox h3 {
    background: rgb(180, 180, 255);
    background-image: url("data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewbox='0 0 100 100'><text y='.9em' font-size=90>&#x2612;</text></svg>");
    color: #ffffff;
    text-align: center;
    width: 100%;
    padding: 10px;
  }

  /* The item text comes in as rendered HTML, so it doesn't get Astro's
     scoping attributes; :global reaches it */
  .itemBox :global(ul) {
    text-align: center;
    list-style: "";
    text-indent: 0;
    padding-left: 0px;
    font-weight: bold;
  }
</style>
