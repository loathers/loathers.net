---
import BaseLayout from "@layouts/BaseLayout.astro";
import layoutStyles from "@components/layout.module.css";
import { getAllPostsSortedAsc, formatDate, getExcerpt } from "@lib/posts";
import { render } from "astro:content";
import type { InferGetStaticPropsType } from "astro";

export async function getStaticPaths() {
  const posts = await getAllPostsSortedAsc();

  return posts.map((post, index) => {
    const previous = index > 0 ? posts[index - 1] : null;
    const next = index < posts.length - 1 ? posts[index + 1] : null;

    return {
      params: { section: post.data.section, slug: post.data.slug },
      props: { post, previous, next },
    };
  });
}

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { post, previous, next } = Astro.props;
const { Content } = await render(post);
const needsPagination = Boolean(previous) || Boolean(next);
---

<BaseLayout
  pageTitle={post.data.title}
  pathName={`/${post.data.section}/${post.data.slug}`}
  description={getExcerpt(post)}
  article={{
    publishedTime: post.data.date,
    author: post.data.author,
    tag: post.data.tag,
  }}
>
  <h1>{post.data.title}</h1>
  <h6>{formatDate(post.data.date)} // {post.data.tag}</h6>
  {
    needsPagination && (
      <nav class="post-nav">
        <ul class={layoutStyles["nav-links"]}>
          {previous && (
            <li>
              <a
                href={`/${previous.data.section}/${previous.data.slug}`}
                class={layoutStyles["nav-link-text"]}
              >
                ← {previous.data.title}
              </a>
            </li>
          )}
          <li class={layoutStyles.navSpacer}>&nbsp;</li>
          {next && (
            <li>
              <a
                href={`/${next.data.section}/${next.data.slug}`}
                class:list={[layoutStyles["nav-link-text"], "next"]}
              >
                {next.data.title} →
              </a>
            </li>
          )}
        </ul>
      </nav>
    )
  }
  <Content />
  <p class="post-author">Article contributed by {post.data.author}</p>
  {
    needsPagination && (
      <nav class="post-nav">
        <ul class={layoutStyles["nav-links"]}>
          {previous && (
            <li>
              <a
                href={`/${previous.data.section}/${previous.data.slug}`}
                class={layoutStyles["nav-link-text"]}
              >
                ← {previous.data.title}
              </a>
            </li>
          )}
          <li class={layoutStyles.navSpacer}>&nbsp;</li>
          {next && (
            <li>
              <a
                href={`/${next.data.section}/${next.data.slug}`}
                class:list={[layoutStyles["nav-link-text"], "next"]}
              >
                {next.data.title} →
              </a>
            </li>
          )}
        </ul>
      </nav>
    )
  }
</BaseLayout>

<script>
  // Give each section heading a link icon so readers can share a link straight
  // to that section. Clicking it also copies the full URL, Discord-ready.
  // Chain icon from Feather Icons (MIT).
  const LINK_ICON = `<svg viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>`;

  document
    .querySelectorAll<HTMLElement>(":is(h2, h3, h4)[id]")
    .forEach((heading) => {
      const anchor = document.createElement("a");
      anchor.className = "heading-anchor";
      anchor.href = `#${heading.id}`;
      anchor.setAttribute("aria-label", `Link to "${heading.textContent}"`);
      anchor.innerHTML = LINK_ICON;

      anchor.addEventListener("click", () => {
        const url = new URL(anchor.href, window.location.href).href;
        navigator.clipboard?.writeText(url).then(() => {
          // Shown with a class rather than :hover, since the jump to the
          // section usually moves the heading out from under the mouse
          anchor.querySelector(".heading-anchor-copied")?.remove();
          const tip = document.createElement("span");
          tip.className = "heading-anchor-copied";
          tip.textContent = "Copied!";
          anchor.append(tip);
          anchor.classList.add("copied");
          setTimeout(() => {
            anchor.classList.remove("copied");
            tip.classList.add("fading");
            tip.addEventListener("transitionend", () => tip.remove(), { once: true });
          }, 1500);
        });
      });
      heading.append(anchor);
    });
</script>

<style>
  /* Added by the script above, so these can't use Astro's scoped styles */
  :global(.heading-anchor) {
    position: relative;
    margin-left: 0.4em;
    font-size: 0.75em;
    color: rgb(170, 170, 170);
    opacity: 0;
    transition: opacity 0.6s;
  }

  /* Leave room above a heading when jumping to it, so it isn't jammed against
     the top of the window and the "Copied!" tooltip stays visible */
  :global(:is(h2, h3, h4)[id]) {
    scroll-margin-top: 2em;
  }

  :global(.heading-anchor svg) {
    vertical-align: -0.1em;
  }

  :global(:is(h2, h3, h4):hover .heading-anchor),
  :global(.heading-anchor:focus-visible) {
    opacity: 1;
    transition-duration: 0.15s;
  }

  /* Phones have no hover, so keep the link faintly visible there */
  @media (hover: none) {
    :global(.heading-anchor) {
      opacity: 0.6;
    }
  }

  /* Keep the icon visible while "Copied!" shows, then fade out gently */
  :global(.heading-anchor.copied) {
    opacity: 1;
    transition-duration: 0.15s;
  }

  /* Floats above the icon so it doesn't push the heading text around */
  :global(.heading-anchor-copied) {
    position: absolute;
    bottom: 100%;
    left: 50%;
    transform: translateX(-50%);
    font-size: 0.7em;
    color: rgb(10, 114, 80);
    white-space: nowrap;
    transition: opacity 0.6s;
  }

  :global(.heading-anchor-copied.fading) {
    opacity: 0;
  }

  /* Block links so the padding wraps the whole title; as inline links, each
     wrapped line got its own padded box that overlapped the line above on hover */
  /* The nav sits inside the post content, so undo the list indents, margins,
     and long-word breaking meant for lists in the post body */
  .post-nav ul {
    padding-left: 0;
  }

  .post-nav li {
    flex: 1 1 0;
    min-width: 0;
    margin: 0;
    padding-left: 0;
    overflow-wrap: normal;
  }

  /* Previous and next split the bar evenly instead of a long title squeezing
     the other one; the spacer just keeps them apart */
  .post-nav li:not(:has(> a)) {
    flex: 0 0 8px;
  }

  .post-nav li:has(> a.next) {
    text-align: right;
  }

  .post-nav a {
    display: inline-block;
    padding: 9px 12px 9px 24px;
    line-height: 1.4;
  }

  .post-nav a.next {
    padding: 9px 24px 9px 12px;
  }

  .post-author {
    margin: 0;
    margin-bottom: 10px;
    color: rgb(102, 102, 102);
    font-family: Menlo, Consolas, monospace;
    font-size: 0.8em;
    height: 20px;
    line-height: 20px;
    text-align: right;
    overflow: hidden;
  }
</style>
